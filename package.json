{
  "name": "tigerroutes",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.940.0",
    "@aws-sdk/client-bedrock-runtime": "^3.940.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "framer-motion": "^12.23.24",
    "google-auth-library": "^10.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "k6": "^0.0.0",
    "lucide-react": "^0.542.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.6",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1",
    "react-scripts": "5.0.1",
    "sweetalert2": "^11.23.0",
    "swiper": "^11.2.10",
    "uuid": "^13.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:node\" \"npm run dev:python\"",
    "lint:watch:server": "eslint server --ext .js,.jsx --watch",
    "dev:watch": "concurrently \"npm run lint:watch:server\" \"npm run dev:node\" \"npm run dev:python\" \"npm run dev:frontend\"",
    "dev:node": "cd server && nodemon server.js",
    "dev:python": "cd server && python -m uvicorn scoringengine:app --reload --port 8000",
    "dev:frontend": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint . --ext .js,.jsx",
    "test:backend": "cross-env NODE_ENV=test jest --config server/utils/jest.config.js --runInBand",
    "test:frontend": "cross-env CI=true react-scripts test --watchAll=false --passWithNoTests",
    "test:ci": "npm run lint && npm run test:backend && npm run test:frontend",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17"
  }
}
